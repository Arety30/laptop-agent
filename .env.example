# ── copy to .env and fill in ────────────────────────────────────────────────
# Discord (from the developer portal). REGENERATE the token if it ever leaked.
DISCORD_TOKEN=paste-your-bot-token-here
APPLICATION_ID=                       # optional, reference only
DISCORD_PUBLIC_KEY=                   # optional, reference only
OWNER_ID=0                            # 0 = open mode (anyone); set your user id to lock it down
WORK_CHANNEL_ID=0                     # optional: channel id where plain msgs = tasks

# Ollama
OLLAMA_HOST=http://127.0.0.1:11434
CODER_MODEL=qwen2.5-coder:1.5b
LIGHT_MODEL=llama3.2:1b

# Filesystem sandbox (agent can only touch paths under here; system dirs blocked)
SANDBOX_ROOT=~
# WORKSPACE=~/laptop-agent/workspace

# Safety
DM_ONLY=false           # true = only respond to DMs, ignore server channels
ALLOW_SHELL=true
SHELL_TIMEOUT=180
MAX_AGENT_ITERATIONS=8

# HTTP surface (Apache proxies /bot/ -> here)
BOT_HTTP_HOST=127.0.0.1
BOT_HTTP_PORT=8765

# Email via n8n, routed THROUGH Apache (/n8n/ -> n8n:5678)
N8N_EMAIL_WEBHOOK=http://127.0.0.1/n8n/webhook/send-email
N8N_TOKEN_WEBHOOK=http://127.0.0.1/n8n/webhook/provision-token
EMAIL_TO=user@example.com
EMAIL_ON_COMPLETE=true

# VM subsystem (sandboxed desktop for Google/Proton web tasks)
VM_ENABLED=true
VM_CONTAINER=la-webtop
VM_URL=http://127.0.0.1:3000

# System monitoring / alerts (needs the bot running on the host)
MONITOR_ENABLED=true
MONITOR_INTERVAL=60
ALERTS_ENABLED=true
ALERT_CPU=92
ALERT_MEM=90
ALERT_DISK=90

# OpenManus (optional; off by default)
OPENMANUS_ENABLED=false
OPENMANUS_HOME=~/OpenManus
